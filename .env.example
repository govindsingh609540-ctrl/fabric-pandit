# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/fabric-pandit?retryWrites=true&w=majority

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:3000
NODE_ENV=development

# OpenAI / Claude AI
OPENAI_API_KEY=sk-your-api-key-here
# or for Claude
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
AI_PROVIDER=openai # openai or anthropic

# Meta WhatsApp Cloud API
META_WHATSAPP_API_KEY=your-meta-api-key-here
META_WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
META_WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
META_WHATSAPP_VERIFY_TOKEN=your-verify-token-for-webhook

# Stripe (for payments)
STRIPE_PUBLIC_KEY=pk_test_your-public-key
STRIPE_SECRET_KEY=sk_test_your-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-public-key

# Admin Authentication
ADMIN_EMAIL=admin@fabricpandit.com
ADMIN_PASSWORD_HASH=your-hashed-password
JWT_SECRET=your-super-secret-jwt-key-for-admin-auth

# Email Service (for order confirmations, notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ADMIN_EMAIL_NOTIFICATION=admin@fabricpandit.com

# Business Info
BUSINESS_NAME=Fabric Pandit
BUSINESS_PHONE=+918160953808
BUSINESS_EMAIL=support@fabricpandit.com
BUSINESS_ADDRESS=Your Business Address

# AI Configuration
AI_MODEL=gpt-4-turbo # or claude-3-opus
AI_TEMPERATURE=0.7
MAX_CONVERSATION_HISTORY=50

# Human Support
SUPPORT_AGENT_QUEUE_ENABLED=true
SUPPORT_AGENT_IDS=agent1,agent2,agent3
